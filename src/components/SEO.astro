---
/**
 * SEO <head> manager — centralises title, meta, OG, Twitter, canonical, JSON-LD.
 * Every page passes its own title/description; defaults come from site data.
 * See docs/01-keyword-research.md §5 (SEO content rules).
 */
import { site, contact } from '@data/site';

interface Props {
  title: string; // page title — should lead with primary keyword
  description?: string;
  image?: string; // OG image path
  canonical?: string; // override canonical URL
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[]; // JSON-LD
}

const {
  title,
  description = site.description,
  image = site.defaultOgImage, // default social share image (1200x630 JPG)
  canonical,
  noindex = false,
  schema,
} = Astro.props;

// Title formula: "Primary Keyword | Brand" (per keyword doc §5.2)
// Only append brand if the title doesn't already contain "Segara"
const fullTitle = /segara/i.test(title) ? title : `${title} | ${site.name}`;
// Prefer trailing-slash URLs to match sitemap + trailingSlash: 'always'
const path = (canonical ?? Astro.url.pathname).replace(/\/?$/, '/') || '/';
const canonicalURL = new URL(path === '//' ? '/' : path, site.url);
const ogImage = new URL(image, site.url);
const ogWidth = 1200;
const ogHeight = 630;
const schemaArray = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#0F3D47" />
<meta name="format-detection" content="telephone=yes" />
<meta name="geo.region" content="ID-BA" />
<meta name="geo.placename" content="Nusa Ceningan, Bali" />
<meta name="geo.position" content={`${site.geo.latitude};${site.geo.longitude}`} />
<meta name="ICBM" content={`${site.geo.latitude}, ${site.geo.longitude}`} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  )
}

{/* Open Graph — rich social sharing (Facebook, WhatsApp, LinkedIn, etc.) */}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content={ogWidth} />
<meta property="og:image:height" content={ogHeight} />
<meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
<meta property="og:locale" content={site.locale} />
{/* Facebook page link (shows "Visit Page" in shared posts) */}
<meta property="article:publisher" content={contact.facebook} />

{/* Twitter Card */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={`${site.name} — ${site.tagline}`} />

{/* JSON-LD structured data */}
{
  schemaArray.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))
}
